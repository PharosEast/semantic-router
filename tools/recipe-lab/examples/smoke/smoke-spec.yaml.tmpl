api_version: recipe-lab/v1alpha1
objective:
  metric_key: accuracy   # sr-bench compare's per-target accuracy field
  direction: maximize
  min_improvement_pct: 1.0
  replay_metric: routed_accuracy
workload:
  # Rendered by the smoke scripts: manifest is the labeled cases JSONL
  # (absolute, since the rendered spec lives in the run dir) and content_hash
  # is `recipe-lab hash --file` of exactly that file (A4 contract check).
  manifest: ${CASES_FILE}
  content_hash: ${CASES_HASH}
  profile: smoke
attribution:
  oracle_policy:
    cloud_frontier_reasoning: cloud/frontier-reasoning
    local_standard: local/private-qwen
    local_privacy_policy: local/private-qwen
    local_security_containment: local/private-qwen
    omni: local/omni
gates: []
budget:
  rounds: 1
  max_minutes_per_trial: 30
stack:
  mode: external
  endpoint: http://127.0.0.1:8899
  baseline_ref: smoke-config@main
